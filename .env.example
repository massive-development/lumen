# ── CPU inference ─────────────────────────────────────────────────────────────
MODEL_PATH=models/BitNet-b1.58-2B-4T/ggml-model-i2_s.gguf
MODEL_ALIAS=bitnet-b1.58-2b-4t
THREADS=

# ── GPU inference ─────────────────────────────────────────────────────────────
CUDA_ARCH=86
CKPT_DIR=checkpoints
GPU_PORT=8082
MAX_SEQ=4096

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=bitnet_memory
POSTGRES_USER=memory
POSTGRES_PASSWORD=change-me

# ── Tool server ───────────────────────────────────────────────────────────────
TOOLS_PORT=8083

# ── Semantic response cache ───────────────────────────────────────────────────
CACHE_PORT=8090
# Cosine similarity threshold (0–1). Higher = stricter; 0.92 is a safe default.
SIMILARITY_THRESHOLD=0.92
# How long (hours) cached responses are valid. Default 168 = 7 days.
CACHE_TTL_HOURS=168

# ── Memory / proxy ────────────────────────────────────────────────────────────
MEMORY_URL=http://memory:6000
PERSONALIZATION_PATH=/etc/bitnet/personalization.json
# Routes Claude Code inference through Olla (CPU+GPU load balanced).
# Change to http://bitnet-cpu:8081 to pin to CPU only.
BACKEND_URL=http://olla:40114/olla/openai

# ── Ollama embeddings ─────────────────────────────────────────────────────────
# Model pulled automatically by ollama-pull on first start.
# Recommended: nomic-embed-text (small, fast) or mxbai-embed-large (higher quality)
EMBEDDING_MODEL=nomic-embed-text

# ── SearXNG ───────────────────────────────────────────────────────────────────
# Generate a random secret: openssl rand -hex 32
SEARXNG_SECRET=change-me

# ── Pipelines ─────────────────────────────────────────────────────────────────
# After stack starts, add http://pipelines:9099 in OpenWebUI Admin → Connections
# using this key. Install pipelines from the community library in that panel.
PIPELINES_API_KEY=change-me

# ── Whisper STT ───────────────────────────────────────────────────────────────
# Smaller = faster startup/inference, larger = more accurate.
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en
WHISPER_MODEL=base.en

# ── Kokoro TTS ────────────────────────────────────────────────────────────────
# Available voices: af_sky, af_bella, af_sarah, am_adam, am_michael,
#                   bf_emma, bf_isabella, bm_george, bm_lewis
KOKORO_VOICE=af_sky

# ── OpenWebUI ─────────────────────────────────────────────────────────────────
OPENAI_API_BASE_URL=http://olla:40114/olla/openai/v1
OPENAI_API_KEY=sk-local
WEBUI_NAME=Lethal Chat
WEBUI_URL=https://bitnet.chat
WEBUI_SECRET_KEY=change-me

# ── Langfuse ──────────────────────────────────────────────────────────────────
# Dashboard at http://localhost:3000 after stack starts.
# After startup: install "Langfuse Filter Pipeline" in OpenWebUI Pipelines and
# configure it with host=http://langfuse:3000, public key, and secret key below.
LANGFUSE_URL=http://localhost:3000
LANGFUSE_ORG_ID=bitnet
LANGFUSE_ORG_NAME=BitNet
LANGFUSE_PROJECT_ID=bitnet-chat
LANGFUSE_PROJECT_NAME=BitNet Chat
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_PUBLIC_KEY=change-me
LANGFUSE_SECRET_KEY=change-me
LANGFUSE_ADMIN_EMAIL=admin@bitnet.local
LANGFUSE_ADMIN_NAME=Admin
LANGFUSE_ADMIN_PASSWORD=change-me

# ── Open Terminal ─────────────────────────────────────────────────────────────
OPEN_TERMINAL_API_KEY=change-me
